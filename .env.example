# =============================================================================
# OracleGG Configuration
# =============================================================================

# Riot API Key
# Get your key at https://developer.riotgames.com/
# Dev keys expire every 24 hours — you can update this in Settings (http://127.0.0.1:8000/settings)
# Apply for a production key once MVP works.
RIOT_API_KEY=RGAPI-change-me

# Region for routing (americas, europe, asia, sea)
# LAN is routed through "americas"
RIOT_REGION=americas

# Platform for platform-specific endpoints (na1, la1, la2, euw1, kr, etc.)
# LAN = la1, LAS = la2
RIOT_PLATFORM=la1

# Your Riot ID (gameName#tagLine) for personal tracking
# Set this to YOUR Riot ID to enable post-game analysis
SUMMONER_RIOT_ID=YourName#TAG

# Claude API Key (optional — enables AI-powered post-game coaching)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# =============================================================================
# League Client Paths (auto-detected if not set)
# =============================================================================
# Windows: C:\Riot Games\League of Legends
# macOS: /Applications/League of Legends.app/Contents/LoL
# LCU_PATH=

# =============================================================================
# Database
# =============================================================================
DB_PATH=./data/oraclegg.db

# =============================================================================
# Polling Intervals (seconds)
# =============================================================================
# How often to poll the Live Client Data API during a game
LIVE_CLIENT_POLL_INTERVAL=3

# How often to check for the LCU lockfile
LCU_POLL_INTERVAL=2

# =============================================================================
# Tip Engine
# =============================================================================
# Minimum seconds between tips shown to user
TIP_COOLDOWN_SECONDS=15

# Max tips per minute (avoid overwhelming)
MAX_TIPS_PER_MINUTE=4

# =============================================================================
# Data Pipeline
# =============================================================================
# Region to collect high-elo data from (na1 has largest Master+ pool)
PIPELINE_REGION=na1

# Number of Master+ players to sample per pipeline run
PIPELINE_PLAYER_SAMPLE_SIZE=500

# Matches to fetch per player
PIPELINE_MATCHES_PER_PLAYER=10

# Minimum matches required for a build recommendation to be shown
PIPELINE_MIN_SAMPLE_SIZE=30

# =============================================================================
# Server
# =============================================================================
HOST=127.0.0.1
PORT=8000
